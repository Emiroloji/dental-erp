APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Canlıda "daily" kullanılır: tek dosya yalnızca büyür, hiç küçülmez ve uzun
# vadede diski doldurur — disk dolunca PostgreSQL de yazamaz hale gelir.
# "daily" her gün yeni dosya açar ve LOG_DAILY_DAYS'ten eskileri kendisi siler,
# yani sunucu tarafında logrotate yapılandırmasına gerek kalmaz.
LOG_STACK=single
# LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Rapor Asistanı (Aşama 25) — Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ASSISTANT_DAILY_LIMIT=50
ASSISTANT_MONTHLY_LIMIT=1000

# Yedekleme (Aşama 28) — pg_dump/psql PATH üzerinde değilse tam yol verin.
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=14
# BACKUP_PG_DUMP=pg_dump
# BACKUP_PSQL=psql

# Yedeğin sunucu dışına kopyalanması (Aşama 30). Yerelde kapalıdır.
# Sunucuda: rclone kurulup bir hedef tanımlandıktan sonra (bkz. docs/yedekleme.md)
#   BACKUP_OFFSITE_DRIVER=rclone
#   BACKUP_RCLONE_REMOTE=drive:dental-erp-yedek
#   BACKUP_RCLONE_CONFIG=/etc/rclone/rclone.conf
BACKUP_OFFSITE_DRIVER=none
BACKUP_RCLONE_REMOTE=
# BACKUP_RCLONE_BINARY=rclone
# BACKUP_RCLONE_CONFIG=
# BACKUP_OFFSITE_MAX_AGE_HOURS=48

# Yedek dışarı çıkmazsa uyarı maili gidecek adres. Boş bırakılırsa yalnızca
# log'a yazılır — ve log'a kimse bakmaz, o yüzden canlıda doldurulmalıdır.
BACKUP_ALERT_EMAIL=
# BACKUP_ALERT_THROTTLE_HOURS=24

# Hata izleme (Aşama 28) — boş bırakılırsa hatalar yalnızca log'a yazılır.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
